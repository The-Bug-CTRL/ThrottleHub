  function evidencePaths(paths,id){return paths is list && paths.size() <= 4 && (paths.size()<1 || evidencePath(paths[0],id)) && (paths.size()<2 || evidencePath(paths[1],id)) && (paths.size()<3 || evidencePath(paths[2],id)) && (paths.size()<4 || evidencePath(paths[3],id));}
  // Contact values are public only with explicit owner consent. Private values
