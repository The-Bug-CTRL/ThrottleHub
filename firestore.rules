  function validBusiness(b){return b is map && b.keys().hasOnly(['name','logoURL','description','category','website','phone','email','hours']) && shortText(b.name,120) && b.name.size() >= 2 && shortText(b.logoURL,2048) && (b.logoURL == '' || b.logoURL.matches('https://[^ ]+')) && shortText(b.description,2000) && b.category in ['Motorcycle dealership','Parts retailer','Riding equipment retailer','Workshop','Professional trader','Other business'] && shortText(b.website,500) && (b.website == '' || b.website.matches('https://[^ ]+')) && shortText(b.phone,40) && shortText(b.email,254) && (b.email == '' || b.email.matches('[^ @]+@[^ @]+[.][^ @]+')) && shortText(b.hours,500);}
  function validAccount(d){return (!('accountType' in d) && !('business' in d)) || (d.accountType in ['personal','business'] && ((d.accountType == 'personal' && d.sellerType == 'private' && !('business' in d)) || (d.accountType == 'business' && d.sellerType == 'dealer' && validBusiness(d.business))));}
  function safePublicContact(d){return (d.get('contactPhone','') == '' || d.get('contactPhonePublic',false) == true) && (!('business' in d) || (d.business.get('phone','') == '' && d.business.get('email','') == '') || d.get('businessContactsPublic',false) == true);}
  function validProfile(d){return safePublicContact(d) && d.get('contactPhonePublic',false) is bool && d.get('businessContactsPublic',false) is bool && shortText(d.get('contactPhone',''),40) && d.get('contactPhone','').matches('[+0-9 ()-]*') && (!('updatedAt' in d) || d.updatedAt is number) && validAccount(d) && d.keys().hasOnly(['displayName','bio','city','region','country','sellerType','createdAt','photoURL','accountType','business','contactPhone','updatedAt','contactPhonePublic','businessContactsPublic']) && shortText(d.displayName,80) && d.displayName.size() >= 2 && shortText(d.bio,600) && shortText(d.city,80) && (d.get('region','') == '' || validProvince(d.region)) && d.country in ['ZA','GB','US','AU'] && d.sellerType in ['private','dealer'] && shortText(d.get('photoURL',''),2048) && (d.get('photoURL','') == '' || d.photoURL.matches('https://[^ ]+')) && d.createdAt is number;}
  match /profiles/{uid} {
   allow read: if owner(uid) || admin() || safePublicContact(resource.data);
   allow create: if owner(uid) && ('accountType' in request.resource.data) && validProfile(request.resource.data) && request.resource.data.createdAt >= request.time.toMillis()-60000 && request.resource.data.createdAt <= request.time.toMillis()+60000;
