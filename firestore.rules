dywork/seat-covers','parts/bodywork/graphics-kits','parts/bodywork/fuel-tank-covers','parts/bodywork/other-plastics','parts/guards','parts/guards/skid-plates','parts/guards/handguards','parts/guards/radiator-guards','parts/guards/disc-guards','parts/guards/engine-case-guards','parts/guards/frame-guards','parts/guards/fork-guards','parts/service','parts/service/oil-filters','parts/service/gaskets','parts/service/bearings','parts/service/seals','parts/service/fastener-kits','parts/service/maintenance-kits','parts/service/service-components','parts/breaking','parts/breaking/complete-bikes-for-breaking','parts/breaking/parts-lots','parts/breaking/mixed-spare-parts','parts/other','riding-gear','riding-gear/helmets','riding-gear/helmets/motocross-helmets','riding-gear/helmets/enduro-helmets','riding-gear/helmets/trials-helmets','riding-gear/helmets/helmet-accessories','riding-gear/boots','riding-gear/boots/motocross-boots','riding-gear/boots/enduro-boots','riding-gear/boots/trials-boots','riding-gear/boots/boot-accessories-and-replacement-parts','riding-gear/clothing','riding-gear/clothing/jerseys','riding-gear/clothing/riding-pants','riding-gear/clothing/jackets','riding-gear/clothing/base-layers','riding-gear/clothing/waterproof-riding-gear','riding-gear/clothing/casual-rider-apparel','riding-gear/protection','riding-gear/protection/chest-protectors','riding-gear/protection/body-armour','riding-gear/protection/knee-braces','riding-gear/protection/knee-guards','riding-gear/protection/neck-braces','riding-gear/protection/elbow-guards','riding-gear/protection/back-protectors','riding-gear/protection/protective-shorts','riding-gear/protection/other-protective-equipment','riding-gear/gloves-goggles','riding-gear/gloves-goggles/riding-gloves','riding-gear/gloves-goggles/goggles','riding-gear/gloves-goggles/lenses','riding-gear/gloves-goggles/tear-offs-roll-offs','riding-gear/gloves-goggles/goggle-accessories','riding-gear/bags-hydration','riding-gear/bags-hydration/hydration-packs','riding-gear/bags-hydration/riding-backpacks','riding-gear/bags-hydration/tool-bags','riding-gear/bags-hydration/waist-packs','electronics','electronics/gps-navigation','electronics/gps-navigation/handheld-gps-devices','electronics/gps-navigation/motorcycle-gps-units','electronics/gps-navigation/gps-navigation-systems','electronics/gps-navigation/navigation-mounts','electronics/gps-navigation/gps-accessories','electronics/gps-navigation/navigation-controllers','electronics/gps-navigation/rally-navigation-equipment','electronics/watches-wearables','electronics/watches-wearables/gps-watches','electronics/watches-wearables/smartwatches','electronics/watches-wearables/fitness-trackers','electronics/watches-wearables/heart-rate-monitors','electronics/watches-wearables/wearable-accessories','electronics/tracking-security','electronics/tracking-security/gps-trackers','electronics/tracking-security/anti-theft-tracking-devices','electronics/tracking-security/motorcycle-alarms','electronics/tracking-security/security-sensors','electronics/tracking-security/tracker-accessories','electronics/ride-data','electronics/ride-data/engine-hour-meters','electronics/ride-data/digital-dashboards','electronics/ride-data/lap-timers','electronics/ride-data/data-loggers','electronics/ride-data/ride-telemetry','electronics/ride-data/electronic-speedometers','electronics/ride-data/other-monitoring-equipment','electronics/cameras','electronics/cameras/action-cameras','electronics/cameras/helmet-cameras','electronics/cameras/camera-mounts','electronics/cameras/camera-batteries','electronics/cameras/camera-accessories','electronics/communication','electronics/communication/helmet-communication-systems','electronics/communication/bluetooth-intercoms','electronics/communication/radios','electronics/communication/communication-accessories','electronics/power','electronics/power/portable-power-banks','electronics/power/chargers','electronics/power/usb-power-systems','electronics/power/12v-accessories','electronics/power/charging-cables-and-mounts','electronics/other','accessories','accessories/transport','accessories/transport/bike-covers','accessories/transport/tie-down-straps','accessories/transport/loading-ramps','accessories/transport/bike-transport-accessories','accessories/transport/motorcycle-luggage','accessories/riding','accessories/riding/off-road-riding-accessories','accessories/riding/pit-equipment','accessories/riding/hydration-accessories','accessories/riding/camping-trail-accessories','accessories/riding/other-equipment','tools','tools/tools','tools/tools/general-motorcycle-tools','tools/tools/engine-tools','tools/tools/flywheel-pullers','tools/tools/bearing-tools','tools/tools/torque-wrenches','tools/tools/carburettor-tools','tools/tools/tyre-changing-tools','tools/tools/suspension-tools','tools/tools/diagnostic-equipment','tools/tools/other-workshop-tools','tools/workshop','tools/workshop/bike-workshop-stands','tools/workshop/lifts','tools/workshop/maintenance-equipment','accessories/other-accessories','riding-gear/other-riding-gear','tools/other-workshop-items']);}
  match /users/{uid}/{privateCollection}/{id} {
   allow read,delete: if owner(uid) && privateCollection in ['favourites','savedSearches','preferences'];
   allow create,update: if owner(uid) && privateCollection == 'savedSearches' && validSaved(request.resource.data);
   allow create,update: if owner(uid) && privateCollection == 'favourites' && request.resource.data.keys().hasOnly(['listingId','createdAt']) && request.resource.data.listingId == id;
  }
  match /conversations/{cid} {
   allow get: if signed() && (!exists(/databases/$(database)/documents/conversations/$(cid)) || request.auth.uid in resource.data.participants);
   allow list: if signed() && request.auth.uid in resource.data.participants;
   allow create: if active() && freshMillis(request.resource.data.createdAt) && shortText(request.resource.data.listingId,128) && shortText(request.resource.data.listingTitle,100) && request.resource.data.listingTitle == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.title && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.country == 'ZA' && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.currency == 'ZAR' && request.resource.data.keys().hasOnly(['listingId','listingTitle','buyerId','sellerId','participants','createdAt']) && request.resource.data.buyerId == request.auth.uid && request.resource.data.sellerId != request.auth.uid && request.resource.data.participants == [request.auth.uid,request.resource.data.sellerId] && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.sellerId && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'published';
   allow update: if signed() && request.auth.uid in resource.data.participants && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt.diff(resource.data.get('readAt',{})).affectedKeys().hasOnly([request.auth.uid]) && freshMillis(request.resource.data.readAt[request.auth.uid]);
   match /messages/{mid} {
    allow read: if participant(cid);
    allow create: if active() && participant(cid) && freshMillis(request.resource.data.createdAt) && request.resource.data.keys().hasOnly(['senderId','text','createdAt']) && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 && request.resource.data.createdAt is number;
    allow update,delete: if false;
   }
  }
  match /listingReports/{id} {
   allow create: if signed() && request.resource.data.keys().hasOnly(['listingId','reporterId','reason','status','createdAt']) && request.resource.data.reporterId == request.auth.uid && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1500 && request.resource.data.status == 'open';
   allow read: if admin();
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['open','reviewed'];
  }
  match /moderationActions/{id} {allow read: if admin();allow create: if admin() && request.resource.data.adminId == request.auth.uid && request.resource.data.keys().hasOnly(['adminId','listingId','reportId','action','createdAt']);}
  match /postingLimits/{uid} {
   allow read: if owner(uid);
   allow create,update: if owner(uid) && request.resource.data.keys().hasOnly(['lastPostAt']) && request.resource.data.lastPostAt == request.time;
  }
  match /restrictions/{uid} {
   allow read: if owner(uid) || moderator();
   allow create,update: if moderator() && request.resource.data.keys().hasOnly(['suspended','reason','actorId','updatedAt']) && request.resource.data.suspended is bool && request.resource.data.actorId == request.auth.uid && shortText(request.resource.data.reason,500);
  }
  function validThread(d){return d.keys().hasOnly(['title','body','category','ownerId','authorName','status','locked','slug','createdAt','updatedAt','lastReplyAt','lastReplyId','searchTokens']) && shortText(d.title,140) && d.title.size() >= 8 && shortText(d.body,12000) && d.body.size() >= 2 && d.category in ['general','motocross','enduro','technical','builds','racing','trails','gear','trading','vintage'] && shortText(d.authorName,80) && shortText(d.slug,160) && d.searchTokens is list && d.searchTokens.size() <= 350 && d.createdAt is number && d.updatedAt is number && d.lastReplyAt is number && d.locked is bool;}
  match /forumThreads/{tid} {
   allow read: if resource.data.status == 'published' || owner(resource.data.ownerId) || moderator();
   allow create: if cooled() && owner(request.resource.data.ownerId) && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName && request.resource.data.status == 'published' && request.resource.data.locked == false && request.resource.data.body.size() >= 20 && validThread(request.resource.data);
   allow update: if (active() && owner(resource.data.ownerId) && resource.data.status == 'published' && resource.data.locked == false && request.resource.data.status in ['published','deleted'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','searchTokens','updatedAt','status']) && validThread(request.resource.data))
    || (cooled() && resource.data.status == 'published' && resource.data.locked == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReplyAt','lastReplyId']) && shortText(request.resource.data.lastReplyId,128) && !exists(/databases/$(database)/documents/forumThreads/$(tid)/replies/$(request.resource.data.lastReplyId)) && getAfter(/databases/$(database)/documents/forumThreads/$(tid)/replies/$(request.resource.data.lastReplyId)).data.ownerId == request.auth.uid && getAfter(/databases/$(database)/documents/forumThreads/$(tid)/replies/$(request.resource.data.lastReplyId)).data.createdAt == request.resource.data.lastReplyAt && freshMillis(request.resource.data.lastReplyAt))
    || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','locked','body','updatedAt']) && request.resource.data.status in ['published','hidden','deleted'] && request.resource.data.locked is bool);
   match /replies/{rid} {
    function parent(){return get(/databases/$(database)/documents/forumThreads/$(tid)).data;}
    allow read: if (resource.data.status == 'published' && parent().status == 'published') || owner(resource.data.ownerId) || moderator();
    allow create: if cooled() && parent().status == 'published' && parent().locked == false && request.resource.data.keys().hasOnly(['body','ownerId','authorName','status','createdAt','updatedAt']) && owner(request.resource.data.ownerId) && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName && request.resource.data.status == 'published' && shortText(request.resource.data.body,6000) && request.resource.data.body.size() >= 2 && request.resource.data.createdAt is number && request.resource.data.updatedAt is number;
    allow update: if (active() && owner(resource.data.ownerId) && parent().locked == false && parent().status == 'published' && resource.data.status == 'published' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','status','updatedAt']) && request.resource.data.status in ['published','deleted'] && shortText(request.resource.data.body,6000) && request.resource.data.body.size() >= 2) || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','status','updatedAt']) && request.resource.data.status in ['published','hidden','deleted']);
   }
  }
  function validArticle(d){return d.keys().hasOnly(['title','body','summary','category','authorName','caption','coverImage','ownerId','status','slug','createdAt','updatedAt','publishedAt','searchTokens']) && shortText(d.title,160) && d.title.size() >= 8 && shortText(d.body,50000) && d.body.size() >= 40 && shortText(d.summary,350) && shortText(d.authorName,80) && shortText(d.caption,300) && shortText(d.coverImage,2000) && d.status in ['draft','published'] && d.category in ['Motocross News','Enduro News','Racing','New Motorcycles','Product Reviews','Riding Gear','Maintenance & Technical','Industry News','Community Stories'] && d.createdAt is number && d.updatedAt is number && d.publishedAt is number && d.searchTokens is list && d.searchTokens.size() <= 350;}
  match /newsArticles/{id} {
   allow read: if resource.data.status == 'published' || admin();
   allow create: if admin() && owner(request.resource.data.ownerId) && validArticle(request.resource.data);
   allow update: if admin() && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt && validArticle(request.resource.data);
   allow delete: if admin();
  }
  function validStolen(d){return d.keys().hasOnly(['make','model','year','colour','features','stolenDate','country','region','city','description','ownerId','images','status','createdAt','updatedAt','searchTokens']) && shortText(d.make,40) && d.make.size() >= 2 && shortText(d.model,80) && d.model.size() >= 1 && d.year is number && d.year >= 1950 && d.year <= 2028 && shortText(d.colour,60) && shortText(d.features,1500) && shortText(d.stolenDate,10) && d.stolenDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.country == 'ZA' && validProvince(d.region) && shortText(d.city,80) && d.city.size() >= 2 && shortText(d.region,80) && d.region.size() >= 2 && shortText(d.description,3000) && d.description.size() >= 20 && d.images is list && d.images.size() <= 4 && d.createdAt is number && d.updatedAt is number && d.searchTokens is list && d.searchTokens.size() <= 350 && d.status in ['pending','published','recovered','rejected','archived'];}
  match /stolenReports/{id} {
   allow read: if (resource.data.status in ['published','recovered'] && resource.data.country == 'ZA') || owner(resource.data.ownerId) || moderator();
   allow create: if active() && owner(request.resource.data.ownerId) && request.resource.data.status == 'pending' && validStolen(request.resource.data);
   allow update: if (active() && owner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt && validStolen(request.resource.data) && ((resource.data.status in ['pending','rejected'] && request.resource.data.status == 'pending') || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && (request.resource.data.status == 'archived' || (resource.data.status == 'published' && request.resource.data.status == 'recovered'))))) || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['pending','published','recovered','rejected','archived']);
   match /private/{privateId} {
    allow read: if owner(get(/databases/$(database)/documents/stolenReports/$(id)).data.ownerId) || moderator();
    allow create,update: if active() && privateId == 'evidence' && getAfter(/databases/$(database)/documents/stolenReports/$(id)).data.status in ['pending','rejected'] && owner(getAfter(/databases/$(database)/documents/stolenReports/$(id)).data.ownerId) && request.resource.data.ownerId == request.auth.uid && request.resource.data.keys().hasOnly(['ownerId','policeCase','frameId','engineId','note','paths']) && shortText(request.resource.data.policeCase,120) && shortText(request.resource.data.frameId,120) && shortText(request.resource.data.engineId,120) && shortText(request.resource.data.note,1500) && evidencePaths(request.resource.data.paths,id);
   }
   match /tips/{tipId} {
    allow read: if owner(get(/databases/$(database)/documents/stolenReports/$(id)).data.ownerId) || moderator();
    allow create: if active() && get(/databases/$(database)/documents/stolenReports/$(id)).data.status in ['published','recovered'] && request.resource.data.keys().hasOnly(['senderId','text','createdAt']) && request.resource.data.senderId == request.auth.uid && shortText(request.resource.data.text,2000) && request.resource.data.text.size() >= 10 && request.resource.data.createdAt is number;
   }
  }
  match /{reportCollection}/{id} {
   allow create: if reportCollection in ['forumReports','stolenFlags','directoryFlags'] && active() && request.resource.data.keys().hasOnly(['targetId','replyId','reporterId','reason','status','createdAt']) && request.resource.data.reporterId == request.auth.uid && shortText(request.resource.data.targetId,128) && shortText(request.resource.data.replyId,128) && shortText(request.resource.data.reason,1500) && request.resource.data.reason.size() >= 10 && request.resource.data.status == 'open' && request.resource.data.createdAt is number;
   allow read: if reportCollection in ['forumReports','stolenFlags','directoryFlags'] && moderator();
   allow update: if reportCollection in ['forumReports','stolenFlags','directoryFlags'] && moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['open','reviewed'];
  }
  match /communityActions/{id} {allow read: if moderator(); allow create: if moderator() && request.resource.data.actorId == request.auth.uid && request.resource.data.keys().hasOnly(['actorId','targetCollection','targetId','action','createdAt']) && shortText(request.resource.data.action,100);}
  function validEvent(d){return d.keys().hasOnly(['title','body','type','startsAt','endsAt','country','region','city','venue','organizer','link','ownerId','status','createdAt','updatedAt']) && shortText(d.title,140) && d.title.size() >= 8 && shortText(d.body,8000) && d.body.size() >= 20 && d.type in ['Motocross','Enduro','Trail ride','Club event','Training','Community ride'] && d.startsAt is number && d.endsAt is number && d.endsAt >= d.startsAt && d.country == 'ZA' && validProvince(d.region) && shortText(d.region,80) && shortText(d.city,80) && shortText(d.venue,160) && shortText(d.organizer,120) && shortText(d.link,500) && (d.link == '' || d.link.matches('https://.*')) && d.status in ['draft','published'];}
  match /events/{id} {
   allow read: if (resource.data.status == 'published' && resource.data.country == 'ZA') || admin();
   allow create: if admin() && owner(request.resource.data.ownerId) && validEvent(request.resource.data);
   allow update: if admin() && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt && validEvent(request.resource.data);
   allow delete: if admin();
  }
  // Reviews are one per author/profile pair. Evidence stays private in the conversation.
  function validReview(d, uid, author) {
   return d.keys().hasOnly(['authorId','authorName','subjectId','listingId','listingTitle','conversationId','role','authorMessageId','subjectMessageId','rating','body','status','response','createdAt','updatedAt'])
    && d.authorId == author && d.subjectId == uid && author != uid
    && d.rating is int && d.rating >= 1 && d.rating <= 5
    && shortText(d.body,2000) && d.body.size() >= 20
    && shortText(d.response,1000) && shortText(d.authorName,80)
    && shortText(d.listingId,128) && shortText(d.listingTitle,100)
    && shortText(d.conversationId,300) && shortText(d.authorMessageId,128) && shortText(d.subjectMessageId,128)
    && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function reviewInteraction(d, uid) {
   let c = get(/databases/$(database)/documents/conversations/$(d.conversationId)).data;
   return request.auth.uid in c.participants && uid in c.participants
    && ((c.buyerId == request.auth.uid && c.sellerId == uid && d.role == 'buyer') || (c.sellerId == request.auth.uid && c.buyerId == uid && d.role == 'seller'))
    && c.listingId == d.listingId && c.listingTitle == d.listingTitle
    && get(/databases/$(database)/documents/conversations/$(d.conversationId)/messages/$(d.authorMessageId)).data.senderId == request.auth.uid
    && get(/databases/$(database)/documents/conversations/$(d.conversationId)/messages/$(d.subjectMessageId)).data.senderId == uid
    && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName == d.authorName;
  }
  match /profiles/{uid}/reviews/{author} {
   allow read: if resource.data.status == 'published' || owner(author) || moderator();
   // An authenticated member can check whether they have already reviewed this profile.
   allow get: if owner(author);
   allow create: if active() && owner(author) && exists(/databases/$(database)/documents/profiles/$(uid))
    && validReview(request.resource.data,uid,author) && reviewInteraction(request.resource.data,uid)
    && request.resource.data.status == 'published' && request.resource.data.response == '' && request.resource.data.createdAt == request.time;
   allow update: if (active() && resource.data.status == 'published' && validReview(request.resource.data,uid,author)
    && ((owner(author) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','body','updatedAt']))
     || (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response','updatedAt']))))
    || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['published','hidden']);
   allow delete: if false;
  }
  match /reviewFlags/{id} {
   allow create: if active() && request.resource.data.keys().hasOnly(['targetId','replyId','reporterId','reason','status','createdAt'])
    && request.resource.data.reporterId == request.auth.uid && shortText(request.resource.data.targetId,128) && shortText(request.resource.data.replyId,128)
    && exists(/databases/$(database)/documents/profiles/$(request.resource.data.targetId)/reviews/$(request.resource.data.replyId))
    && shortText(request.resource.data.reason,1500) && request.resource.data.reason.size() >= 10 && request.resource.data.status == 'open' && request.resource.data.createdAt is number;
   allow read: if moderator();
   allow update: if moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['open','reviewed'];
  }
  function validDirectory(d){return d.keys().hasOnly(['kind','title','body','category','organisation','region','city','contactEmail','price','ownerId','country','status','createdAt','updatedAt'])
   && d.kind in ['job','entry','service'] && shortText(d.title,140) && d.title.size() >= 8 && shortText(d.body,6000) && d.body.size() >= 20
   && ((d.kind == 'job' && d.category in ['Workshop & mechanics','Sales & retail','Riding & coaching','Events & operations','Marketing & admin','Other jobs'])
    || (d.kind == 'entry' && d.category in ['Race entries','Trail ride entries','Club events','Training days','Other entries'])
    || (d.kind == 'service' && d.category in ['Repairs & servicing','Suspension & tuning','Bike transport','Training & coaching','Rentals & tours','Accommodation','Other services']))
   && shortText(d.organisation,120) && validProvince(d.region) && shortText(d.city,80) && d.city.size() >= 2
   && shortText(d.contactEmail,254) && d.contactEmail.matches('[^ @]+@[^ @]+[.][^ @]+')
   && d.price is number && d.price >= 0 && d.price <= 10000000 && d.country == 'ZA'
   && d.createdAt is number && d.updatedAt is number && d.status in ['pending','published','rejected','archived'];}
  match /directoryPosts/{id} {
   allow read: if (resource.data.status == 'published' && resource.data.country == 'ZA') || owner(resource.data.ownerId) || moderator();
   allow create: if active() && owner(request.resource.data.ownerId) && request.resource.data.status == 'pending' && validDirectory(request.resource.data);
   allow update: if (active() && owner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.status in ['pending','archived'] && validDirectory(request.resource.data))
    || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['pending','published','rejected','archived']);
   allow delete: if false;
  }

  // Payment orders, entitlements, limits, receipts, reviews and accounting are
  // server-only, including nested audit events. Seller access uses verified APIs.
  // Support payloads, notes, credentials, quotas and audit history are API-only.
  match /supportSignals/{id} {
   allow get: if (id == "staff" && admin()) || (signed() && id == "user-" + request.auth.uid);
   allow list, write: if false;
  }
  match /supportTickets/{path=**} { allow read, write: if false; }
  match /profileContacts/{uid} { allow read, write: if false; }
  // Forum media and admission records are trusted API-only.
  match /forumMedia/{id} { allow read,write: if false; }
  match /forumPostLimits/{id} { allow read,write: if false; }
  match /forumMediaQuotas/{id} { allow read,write: if false; }
  match /forumMediaControl/{id} { allow read,write: if false; }
  match /{document=**} {allow read,write: if false;}
 }
}

