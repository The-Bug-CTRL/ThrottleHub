  function validSaved(d){let f=d.filters;return d.keys().hasOnly(['name','filters','createdAt','notificationsEnabled','version']) && shortText(d.name,160) && d.name.size() > 0 && d.createdAt is number && d.version == 2 && d.notificationsEnabled == false && f is map && f.keys().hasOnly(['country','category','term','make','model','year','yearFrom','yearTo','region','city','condition','shipping','min','max','sort','engineType','displacement','maxHours','fuelSystem','origin','brand','size','sizeSystem','sellerType','vintage']) && shortText(f.country,100) && shortText(f.category,100) && shortText(f.term,100) && shortText(f.make,100) && shortText(f.model,100) && shortText(f.year,100) && shortText(f.yearFrom,100) && shortText(f.yearTo,100) && shortText(f.region,100) && shortText(f.city,100) && shortText(f.condition,100) && shortText(f.shipping,100) && shortText(f.min,100) && shortText(f.max,100) && shortText(f.sort,100) && shortText(f.engineType,100) && shortText(f.displacement,100) && shortText(f.maxHours,100) && shortText(f.fuelSystem,100) && shortText(f.origin,100) && shortText(f.brand,100) && shortText(f.size,100) && shortText(f.sizeSystem,100) && shortText(f.sellerType,100) && shortText(f.vintage,100) && f.country == 'ZA' && (f.category == '' || f.category in ['motorcycles','motorcycles/motocross','motorcycles/motocross/two-stroke-motocross','motorcycles/motocross/four-stroke-motocross','motorcycles/motocross/youth-motocross','motorcycles/enduro','motorcycles/enduro/hard-enduro','motorcycles/enduro/cross-country-enduro','motorcycles/enduro/trail-enduro','motorcycles/enduro/road-legal-enduro','motorcycles/trials','motorcycles/trials/modern-trials','motorcycles/trials/youth-trials','motorcycles/trail','motorcycles/trail/trail-bikes','motorcycles/trail/recreational-off-road-bikes','motorcycles/trail/youth-mini-bikes','motorcycles/pit-bikes','motorcycles/kids-bikes','parts','parts/complete-engines','parts/complete-engines/complete-engines','parts/complete-engines/engine-c