   id == 'motorcycles/motocross/two-stroke-motocross' ? ['Motorcycles','Two-Stroke Motocross',['motorcycles','motorcycles/motocross'],{'l0':'motorcycles','l1':'motorcycles/motocross','l2':'motorcycles/motocross/two-stroke-motocross'},['two-stroke']] : 
   id == 'motorcycles/motocross/four-stroke-motocross' ? ['Motorcycles','Four-Stroke Motocross',['motorcycles','motorcycles/motocross'],{'l0':'motorcycles','l1':'motorcycles/motocross','l2':'motorcycles/motocross/four-stroke-motocross'},['four-stroke']] : 
   id == 'motorcycles/motocross/youth-motocross' ? ['Motorcycles','Youth Motocross',['motorcycles','motorcycles/motocross'],{'l0':'motorcycles','l1':'motorcycles/motocross','l2':'motorcycles/motocross/youth-motocross'},[]] :  [];}
