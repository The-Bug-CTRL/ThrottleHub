rules_version = '2';
// Canonical normal-operation policy. Deploy only after reviewing the release plan.
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function admin(){return signed() && request.auth.token.get('admin', false) == true;}
  function moderator(){return admin() || (signed() && request.auth.token.get('moderator', false) == true);}
  function active(){return signed() && (!exists(/databases/$(database)/documents/restrictions/$(request.auth.uid)) || get(/databases/$(database)/documents/restrictions/$(request.auth.uid)).data.suspended == false);}
  function cooled(){return active() && getAfter(/databases/$(database)/documents/postingLimits/$(request.auth.uid)).data.lastPostAt == request.time && (!exists(/databases/$(database)/documents/postingLimits/$(request.auth.uid)) || request.time >= get(/databases/$(database)/documents/postingLimits/$(request.auth.uid)).data.lastPostAt + duration.value(15,'s'));}
  function owner(uid){return signed() && request.auth.uid == uid;}
  function participant(cid){return signed() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;}
  function freshMillis(value){return value is number && value >= request.time.toMillis()-60000 && value <= request.time.toMillis()+60000;}
  function shortText(value, max){return value is string && value.size() <= max;}
  function validDetails(d){let x=d.details;return x is map && x.keys().hasOnly(['engineType','displacement','hours','yearFrom','yearTo','fuelSystem','origin','partNumber','brand','size','sizeSystem','sellerType','vintage']) && x.engineType in ['','two-stroke','four-stroke'] && x.displacement is number && x.displacement >= 0 && x.displacement <= 2000 && x.hours is number && x.hours >= 0 && x.hours <= 100000 && x.yearFrom is int && x.yearTo is int && (x.yearFrom == 0 || (x.yearFrom >= 1950 && x.yearFrom <= 2028)) && (x.yearTo == 0 || (x.yearTo >= 1950 && x.yearTo <= 2028)) && (x.yearFrom == 0 || x.yearTo == 0 || x.yearTo >= x.yearFrom) && x.fuelSystem in ['','carburettor','fuel-injection'] && x.origin in ['','OEM','aftermarket'] && shortText(x.partNumber,100) && shortText(x.brand,80) && shortText(x.size,40) && x.sizeSystem in ['','UK','US','EU','alpha','cm'] && x.sellerType in ['private','dealer'] && x.vintage is bool && (d.primaryCategoryId in ['motorcycles','parts'] || (d.make == '' && d.model == '' && d.year == 0 && x.engineType == '' && x.displacement == 0 && x.hours == 0 && x.yearFrom == 0 && x.yearTo == 0 && x.origin == '' && x.partNumber == '' && x.fuelSystem == ''));}
  // BEGIN GENERATED MARKETPLACE CATEGORIES — run node scripts/marketplace-rules.mjs
  function categoryBucket0(id){return 
   id == 'motorcycles' ? ['Motorcycles','Motorcycles',[],{'l0':'motorcycles'},[]] : 
   id == 'parts' ? ['Parts & Spares','Parts & Spares',[],{'l0':'parts'},[]] : 
   id == 'riding-gear' ? ['Riding Gear & Apparel','Riding Gear & Apparel',[],{'l0':'riding-gear'},[]] : 
   id == 'electronics' ? ['Electronics & Technology','Electronics & Technology',[],{'l0':'electronics'},[]] : 
   id == 'accessories' ? ['Accessories & Equipment','Accessories & Equipment',[],{'l0':'accessories'},[]] : 
   id == 'tools' ? ['Tools & Workshop','Tools & Workshop',[],{'l0':'tools'},[]] :  [];}
  function categoryBucket1(id){return 
   id == 'motorcycles/motocross' ? ['Motorcycles','Motocross',['motorcycles'],{'l0':'motorcycles','l1':'motorcycles/motocross'},[]] : 
   id == 'motorcycles/enduro' ? ['Motorcycles','Enduro',['motorcycles'],{'l0':'motorcycles','l1':'motorcycles/enduro'},[]] : 
   id == 'motorcycles/trials' ? ['Motorcycles','Trials',['motorcycles'],{'l0':'motorcycles','l1':'motorcycles/trials'},[]] : 
   id == 'motorcycles/trail' ? ['Motorcycles','Trail & Recreational',['motorcycles'],{'l0':'motorcycles','l1':'motorcycles/trail'},[]] : 
   id == 'motorcycles/pit-bikes' ? ['Motorcycles','Pit bikes',['motorcycles'],{'l0':'motorcycles','l1':'motorcycles/pit-bikes'},[]] : 
   id == 'motorcycles/kids-bikes' ? ['Motorcycles','Kids bikes',['motorcycles'],{'l0':'motorcycles','l1':'motorcycles/kids-bikes'},[]] :  [];}
