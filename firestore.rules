  // END GENERATED MARKETPLACE CATEGORIES
  function validListing(d){return d.keys().hasOnly(['id','ownerId','slug','title','description','category','subcategory','make','model','year','price','currency','country','region','city','condition','shipping','deliveryMethods','specs','images','status','createdAt','updatedAt','searchTokens','categoryId','primaryCategoryId','categoryAncestorIds','categoryPath','details'])
