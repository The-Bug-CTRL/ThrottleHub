# Real Firebase profile. The actual supplied Web config is in the ignored .env.local.
NEXT_PUBLIC_FIREBASE_MODE=development
NEXT_PUBLIC_FIREBASE_DEV_PROJECT_ID=throttlehub-9d6b9
NEXT_PUBLIC_FIREBASE_PROJECT_ID=throttlehub-9d6b9
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=throttlehub-9d6b9.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=throttlehub-9d6b9.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
GCLOUD_PROJECT=throttlehub-9d6b9
# SERVER ONLY: set a path to an existing authorised credential outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/existing-credential.json

# SERVER ONLY: install current FFmpeg/ffprobe; these optional overrides select their executables.
# FFPROBE_PATH=C:/absolute/path/ffprobe.exe
# FFMPEG_PATH=C:/absolute/path/ffmpeg.exe

# Server-only paid promotions. Keep disabled until test setup is reviewed.
THROTTLEHUB_PAYMENTS_ENABLED=false
THROTTLEHUB_PAYSTACK_MODE=test
THROTTLEHUB_APP_URL=http://localhost:3000
# Secret Manager is preferred. An optional local TEST key may be supplied server-only.
# THROTTLEHUB_PAYSTACK_TEST_SECRET_KEY=
THROTTLEHUB_BUMP_COOLDOWN_HOURS=48
THROTTLEHUB_PROMOTION_PREVIEW_TEST=false
THROTTLEHUB_ENABLE_LIVE_PAYMENTS=disabled
